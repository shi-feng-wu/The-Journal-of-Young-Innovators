# Copy to .env.local (local dev) or to .env.local in the app directory on the
# server, then fill in the values. Never commit the real file.

# ---- Email (Zoho Mail SMTP) ------------------------------------------------
# Sends submission notices, author confirmations, portal letters and invites.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=editor@young-innovator.org
SMTP_PASS=
# Optional. From address on outgoing mail, and the inbox that receives
# submission notices, author replies and blind copies of portal letters.
SUBMISSION_FROM=editor@young-innovator.org
SUBMISSION_TO=editor@young-innovator.org
# Optional. Set to false to stop blind-copying portal letters to the inbox.
PORTAL_BCC_INBOX=true

# ---- Editor portal ---------------------------------------------------------
# Where the portal database and manuscripts live. On the server, keep this
# outside the app checkout so deploys never touch it, and back it up.
# Defaults to ./data when unset.
PORTAL_DATA_DIR=/home/deploy/jyi-data

# ---- Stripe (publication fee) ----------------------------------------------
# Signing secret of the webhook endpoint https://young-innovator.org/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
# charge.refunded). Dashboard: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
# Optional. Restricted key with read access to Checkout Sessions,
# PaymentIntents and Charges; turns on the "Sync from Stripe" button.
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_RESTRICTED_KEY=

# ---- Zoho Mail API (inbox sync) --------------------------------------------
# Self Client from https://api-console.zoho.com with the scopes
# ZohoMail.messages.READ,ZohoMail.folders.READ. Used by `pnpm portal:sync-inbox`.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=2323868000000008002
# Optional, only for accounts outside the US data center.
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_MAIL_API_URL=https://mail.zoho.com

# ---- Site ------------------------------------------------------------------
# Optional search-console verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Optional. Where web-vitals beacons are sent; defaults to /api/vitals.
# NEXT_PUBLIC_VITALS_ENDPOINT=
